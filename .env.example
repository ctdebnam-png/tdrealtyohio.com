# Variable NAMES the Pages Functions in functions/ read. No values belong in
# this file or anywhere in the repository.
#
# Production: set each one in the Cloudflare dashboard, Workers & Pages >
# the Pages project > Settings > Variables and Secrets (as a Secret where
# marked). Local `npm run dev` (wrangler pages dev): copy this file to
# .dev.vars and fill in test values. .dev.vars and .env are gitignored.
#
# Every one is optional: a function whose variables are missing skips that
# step (no email, no Sheets row, no Turnstile check) and still stores the
# lead in KV.

# Lead notification email, sent through Resend (functions/lib/notify.js)
RESEND_API_KEY=            # Secret
NOTIFY_FROM=               # verified sender address
NOTIFY_TO=                 # recipient; the code has a default when unset

# Cloudflare Turnstile on the lead forms (functions/lib/turnstile.js,
# functions/_middleware.js puts the site key in each page's <head>)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=      # Secret

# Copy of each lead posted to the Google Sheets Apps Script webhook
# (functions/lib/sheets.js)
SHEETS_WEBHOOK_URL=        # Secret
SHEETS_WEBHOOK_SECRET=     # Secret

# X-Export-Key header value for GET /api/leads-export
EXPORT_KEY=                # Secret

# KV namespace BINDINGS, not variables: declared in wrangler.toml and bound
# in the Pages project settings, never set here.
#   LEADS   lead and agent application records (required)
#   EVENTS  analytics events (optional; commented out in wrangler.toml)
