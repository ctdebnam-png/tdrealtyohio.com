{
  "name": "td-realty-ads-bot",
  "version": "1.0.0",
  "description": "Daily ads optimization bot for TD Realty Ohio - Google Ads, GA4, GSC data pulls and analysis",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "pull": "node pull/index.mjs",
    "pull:ads": "node pull/google_ads_pull.mjs",
    "pull:gsc": "node pull/gsc_pull.mjs",
    "pull:ga4": "node pull/ga4_pull.mjs",
    "analyze": "node analyze/daily.mjs",
    "plan": "node plan/generate.mjs",
    "report": "node pull/index.mjs && node analyze/daily.mjs && node plan/generate.mjs",
    "validate-landing-map": "node plan/validate_landing_map.mjs"
  },
  "dependencies": {
    "googleapis": "^140.0.0",
    "google-auth-library": "^9.0.0",
    "@google-ads/api": "^18.0.0"
  }
}
