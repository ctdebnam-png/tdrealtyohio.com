{
  "name": "td-environmental",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Market research data and public marketing site for TD Environmental, a trade name of TD Realty Ohio, LLC.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "npm run check:links && npm run check:data",
    "build": "astro build && npm run check:orc && npm run check:link-text",
    "preview": "astro preview",
    "check:links": "tsx scripts/check-links.ts",
    "check:links:report": "tsx scripts/check-links.ts --no-write",
    "check:data": "tsx scripts/check-data.ts",
    "check:orc": "tsx scripts/check-orc-4733.ts",
    "check:astro": "astro check",
    "test:a11y": "playwright test",
    "check:all": "npm run check:data && npm run check:links && astro build && npm run check:orc && npm run check:link-text",
    "check:link-text": "tsx scripts/check-link-text.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "astro": "^5.14.1",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.18.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vite": "^6.4.3"
  },
  "overrides": {
    "vite": "$vite",
    "playwright-core": "1.56.1"
  }
}
