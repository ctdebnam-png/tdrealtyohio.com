---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, IS_PUBLISHED, HOLD_NOTICE } from '../lib/site.js';
import { PROHIBITED_TERM_PATTERN, ORC_CITATION } from '../lib/prohibited-terms.js';

interface Props {
  title: string;
  description: string;
  /** Set on /internal/ pages so they stay out of indexes. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

/**
 * Belt and braces on ORC 4733.16: scripts/check-orc-4733.ts catches a
 * prohibited term in the built output, but failing here stops it being built
 * at all, with the offending page named.
 */
for (const [label, value] of [
  ['title', title],
  ['description', description],
] as const) {
  if (PROHIBITED_TERM_PATTERN.test(value)) {
    throw new Error(
      `${ORC_CITATION}: page ${Astro.url.pathname} has a prohibited term in its ${label}: "${value}"`,
    );
  }
}

const fullTitle = `${title} | ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      /*
       * While held, every page is noindex regardless of its own setting.
       * robots.txt is not enough on its own: a page linked from elsewhere can
       * still be indexed without ever being crawled.
       */
      !IS_PUBLISHED ? (
        <meta
          name="robots"
          content="noindex, nofollow, noarchive, nosnippet, noimageindex"
        />
      ) : (
        noindex && <meta name="robots" content="noindex, nofollow" />
      )
    }
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only rounded-sm bg-moss-deep px-4 py-2 text-white focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50"
    >
      Skip to main content
    </a>
    {
      !IS_PUBLISHED && (
        <p
          class="bg-clay px-4 py-2 text-center text-sm font-medium text-white"
          data-publish-hold="true"
        >
          {HOLD_NOTICE}
        </p>
      )
    }
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
