---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProposalForm from '../../components/ProposalForm.astro';
import { SITE, IS_PUBLISHED } from '../../lib/site.js';
---

<BaseLayout
  title="Request a proposal"
  description="Send the property details and the deadline driving the work, and TD Environmental will return a scoped proposal."
>
  <div class="wrap py-12">
    <h1 class="text-3xl">Request a proposal</h1>
    <p class="mt-3 max-w-2xl text-lg text-ink-muted">
      Six answers about the property are enough to scope most sites. If
      something is unknown, say so — an unknown is a fact about the property
      too, and we would rather have it than a guess.
    </p>

    <ProposalForm />

    {
      IS_PUBLISHED && (
        <p class="mt-10 text-ink-muted">
          Prefer to talk it through?
          <a href={SITE.phone_href}>Call {SITE.phone_display}</a>.
        </p>
      )
    }
  </div>
</BaseLayout>
