---
import InternalLayout from '../../layouts/InternalLayout.astro';
import Provenance from '../../components/Provenance.astro';
import { getCredentials } from '../../lib/data.js';
import type { Credential, CredentialHolder } from '../../schemas/credentials.js';

const credentials = getCredentials();

const HOLDER_LABELS: Record<CredentialHolder, string> = {
  travis: 'Travis',
  kwame: 'Kwame',
  sam: 'Sam',
  firm: 'The firm',
};

const holders = (Object.keys(HOLDER_LABELS) as CredentialHolder[]).filter((holder) =>
  credentials.some((credential) => credential.holder === holder),
);

const yearGroups: { key: 'year-one' | 'year-three' | 'unsequenced'; label: string; match: (c: Credential) => boolean }[] = [
  { key: 'year-one', label: 'Year one', match: (c) => c.plan_year === 1 },
  { key: 'year-three', label: 'Year three', match: (c) => c.plan_year === 3 },
  { key: 'unsequenced', label: 'Not sequenced yet', match: (c) => c.plan_year === null },
];

const money = (value: number | null) =>
  value === null ? '' : `$${value.toLocaleString('en-US')}`;

const th = 'border border-rule bg-moss-tint px-3 py-2 text-left text-sm font-semibold';
const td = 'border border-rule px-3 py-2 align-top text-sm';

const recognitionTone: Record<Credential['market_recognition'], string> = {
  gate: 'bg-red-100 text-red-900',
  strong: 'bg-moss-tint text-moss-deep',
  moderate: 'bg-amber-100 text-amber-900',
  vanity: 'bg-gray-200 text-gray-800',
};
---

<InternalLayout
  title="Credential plan"
  purpose="Every credential considered, grouped by who would hold it and when it would be earned. A blank cost is a cost nobody has confirmed, not a free credential."
>
  {
    credentials.length === 0 ? (
      <p class="mt-8 rounded-sm border border-dashed border-rule p-5 text-ink-muted">
        No credential records yet. Add them to <code>src/data/credentials.yaml</code>.
      </p>
    ) : (
      <>
        <p class="mt-6 text-sm text-ink-muted">
          {credentials.filter((c) => c.market_recognition === 'gate').length} of{' '}
          {credentials.length} are gates: work cannot be sold without them.
        </p>

        {holders.map((holder) => (
          <section aria-labelledby={`holder-${holder}`} class="mt-12">
            <h2 id={`holder-${holder}`} class="text-xl">
              {HOLDER_LABELS[holder]}
            </h2>

            {yearGroups.map((group) => {
              const rows = credentials.filter(
                (credential) => credential.holder === holder && group.match(credential),
              );
              if (rows.length === 0) return null;
              return (
                <div
                  class="mt-6 overflow-x-auto"
                  tabindex="0"
                  role="region"
                  aria-label={`${HOLDER_LABELS[holder]}, ${group.label.toLowerCase()}, scrollable`}
                >
                  <table class="w-full min-w-[72rem]">
                    <caption class="mb-2 text-base font-semibold text-clay">{group.label}</caption>
                    <thead>
                      <tr>
                        <th scope="col" class={th}>Credential</th>
                        <th scope="col" class={th}>Issuing body</th>
                        <th scope="col" class={th}>Prerequisites</th>
                        <th scope="col" class={th}>Coursework</th>
                        <th scope="col" class={th}>Exam</th>
                        <th scope="col" class={th}>Experience</th>
                        <th scope="col" class={th}>Initial cost</th>
                        <th scope="col" class={th}>Upkeep</th>
                        <th scope="col" class={th}>Time to earn</th>
                        <th scope="col" class={th}>Recognition</th>
                        <th scope="col" class={th}>Publishable</th>
                        <th scope="col" class={th}>Verdict</th>
                        <th scope="col" class={th}>Provenance</th>
                      </tr>
                    </thead>
                    <tbody>
                      {rows.map((credential) => (
                        <tr>
                          <th scope="row" class={`${td} font-semibold`}>
                            {credential.url ? (
                              <a href={credential.url} rel="nofollow noopener">
                                {credential.name}
                              </a>
                            ) : (
                              credential.name
                            )}
                            {credential.license_number && (
                              <p class="font-normal text-ink-muted">#{credential.license_number}</p>
                            )}
                          </th>
                          <td class={td}>{credential.issuing_body}</td>
                          <td class={td}>
                            {credential.prerequisites.length > 0
                              ? credential.prerequisites.join('; ')
                              : '—'}
                          </td>
                          <td class={td}>{credential.coursework ?? ''}</td>
                          <td class={td}>{credential.exam ?? ''}</td>
                          <td class={td}>{credential.experience_requirement ?? ''}</td>
                          <td class={td}>{money(credential.cost_initial)}</td>
                          <td class={td}>{money(credential.cost_maintenance)}</td>
                          <td class={td}>{credential.time_to_earn ?? ''}</td>
                          <td class={td}>
                            <span
                              class={`rounded-sm px-2 py-0.5 text-xs font-medium ${recognitionTone[credential.market_recognition]}`}
                            >
                              {credential.market_recognition}
                            </span>
                          </td>
                          <td class={td}>
                            {credential.earned_at
                              ? `earned ${credential.earned_at}`
                              : credential.displayable_on_join
                                ? 'on joining'
                                : 'not yet'}
                          </td>
                          <td class={td}>{credential.verdict}</td>
                          <td class={td}>
                            <Provenance record={credential} />
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              );
            })}
          </section>
        ))}
      </>
    )
  }
</InternalLayout>
