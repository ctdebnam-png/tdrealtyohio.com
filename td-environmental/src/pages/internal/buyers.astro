---
import InternalLayout from '../../layouts/InternalLayout.astro';
import Provenance from '../../components/Provenance.astro';
import { getBuyers, SEGMENT_LABELS } from '../../lib/data.js';

const buyers = getBuyers();
const segments = [...new Set(buyers.map((buyer) => buyer.segment))].sort();

const th = 'border border-rule bg-moss-tint px-3 py-2 text-left text-sm font-semibold';
const td = 'border border-rule px-3 py-2 align-top text-sm';
---

<InternalLayout
  title="Buyers as a call list"
  purpose="Who to call, how to reach them, and what they are buying. These records stay internal: the public who-we-serve pages describe segments, not named firms."
>
  {
    buyers.length === 0 ? (
      <p class="mt-8 rounded-sm border border-dashed border-rule p-5 text-ink-muted">
        No buyer records yet. Add them to <code>src/data/buyers.yaml</code>.
      </p>
    ) : (
      segments.map((segment) => (
        <section class="mt-10 overflow-x-auto">
          <table class="w-full min-w-[60rem]">
            <caption class="mb-2 text-lg font-semibold text-moss-deep">
              {SEGMENT_LABELS[segment].plural}
              <span class="ml-2 text-sm font-normal text-ink-muted">
                (<a href={`/who-we-serve/${SEGMENT_LABELS[segment].slug}/`}>public page</a>)
              </span>
            </caption>
            <thead>
              <tr>
                <th scope="col" class={th}>Organisation</th>
                <th scope="col" class={th}>City</th>
                <th scope="col" class={th}>Phone</th>
                <th scope="col" class={th}>Who to approach</th>
                <th scope="col" class={th}>Credentials held</th>
                <th scope="col" class={th}>Why they buy</th>
                <th scope="col" class={th}>Called on (fill in)</th>
                <th scope="col" class={th}>Provenance</th>
              </tr>
            </thead>
            <tbody>
              {buyers
                .filter((buyer) => buyer.segment === segment)
                .map((buyer) => (
                  <tr>
                    <th scope="row" class={`${td} font-semibold`}>
                      {buyer.url ? (
                        <a href={buyer.url} rel="nofollow noopener">
                          {buyer.name}
                        </a>
                      ) : (
                        buyer.name
                      )}
                    </th>
                    <td class={td}>{buyer.city ?? '—'}</td>
                    <td class={td}>{buyer.phone ?? '—'}</td>
                    <td class={td}>{buyer.contact_path ?? '—'}</td>
                    <td class={td}>
                      {buyer.credentials_held.length > 0 ? buyer.credentials_held.join(', ') : '—'}
                    </td>
                    <td class={td}>{buyer.why_they_buy}</td>
                    <td class={`${td} bg-amber-50`}></td>
                    <td class={td}>
                      <Provenance record={buyer} />
                    </td>
                  </tr>
                ))}
            </tbody>
          </table>
        </section>
      ))
    )
  }
</InternalLayout>
