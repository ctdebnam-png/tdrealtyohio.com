---
import InternalLayout from '../../layouts/InternalLayout.astro';
import {
  getSubcontractors,
  getBuyers,
  getCredentials,
  getServices,
  getPricing,
  getRegulatory,
  getMarketLanguage,
  getTeam,
} from '../../lib/data.js';

const views = [
  {
    href: '/internal/subcontractors/',
    label: 'Subcontractors',
    count: getSubcontractors().length,
    note: 'Rate columns are blank by design. Fill them from a quote, not from memory.',
  },
  {
    href: '/internal/buyers/',
    label: 'Buyers as a call list',
    count: getBuyers().length,
    note: 'Who to call, how to reach them, and what they are buying.',
  },
  {
    href: '/internal/credentials/',
    label: 'Credential plan',
    count: getCredentials().length,
    note: 'Sequenced by holder and by year one versus year three.',
  },
  {
    href: '/internal/pricing/',
    label: 'Pricing',
    count: getPricing().length,
    note: 'Sourced figures and constructed figures are kept in separate tables.',
  },
  {
    href: '/internal/regulatory/',
    label: 'Regulatory requirements',
    count: getRegulatory().length,
    note: 'Blockers first: the rules that stop us selling work today.',
  },
  {
    href: '/internal/services/',
    label: 'Blocked services',
    count: getServices().filter((service) => service.delivery === 'blocked').length,
    note: 'Never rendered on the public site. Each one names what is in the way.',
  },
  {
    href: '/internal/market-language/',
    label: 'Market language',
    count: getMarketLanguage().length,
    note: 'How competitors name and organise the same work.',
  },
];

/** Every record in the data set, across all files. */
const totalRecords = [
  getSubcontractors(),
  getBuyers(),
  getCredentials(),
  getServices(),
  getPricing(),
  getRegulatory(),
  getMarketLanguage(),
  getTeam(),
].reduce((sum, records) => sum + records.length, 0);
---

<InternalLayout
  title="Internal data views"
  purpose="The full research data set, rendered as working tables. Not linked from the public site, excluded from the sitemap, and disallowed in robots.txt."
>
  <ul class="mt-8 grid gap-4 md:grid-cols-2">
    {
      views.map((view) => (
        <li class="rounded-sm border border-rule p-5">
          <h2 class="text-lg">
            <a href={view.href} class="no-underline hover:underline">
              {view.label}
            </a>
          </h2>
          <p class="mt-1 text-sm font-medium text-ink-muted">
            {view.count} record{view.count === 1 ? '' : 's'}
          </p>
          <p class="mt-2 text-sm text-ink-muted">{view.note}</p>
        </li>
      ))
    }
  </ul>

  <section aria-labelledby="rules" class="mt-12 max-w-3xl">
    <h2 id="rules" class="text-lg">The rules these tables run on</h2>
    <ul class="mt-3 list-disc space-y-2 pl-6 text-sm text-ink-muted">
      <li>A number that is not in a cited source is not written down. The cell stays blank.</li>
      <li>
        A number derived from other numbers carries <code>basis: constructed</code> and a
        construction method that shows the arithmetic.
      </li>
      <li>
        A URL that has not returned 2xx to the link checker is not published. Run
        <code>npm run check:links</code>.
      </li>
      <li>Data set holds {totalRecords} record{totalRecords === 1 ? '' : 's'} across all files.</li>
    </ul>
  </section>
</InternalLayout>
