---
import InternalLayout from '../../layouts/InternalLayout.astro';
import Provenance from '../../components/Provenance.astro';
import { getMarketLanguage } from '../../lib/data.js';

const entries = getMarketLanguage();

const th = 'border border-rule bg-moss-tint px-3 py-2 text-left text-sm font-semibold';
const td = 'border border-rule px-3 py-2 align-top text-sm';
---

<InternalLayout
  title="Market language"
  purpose="How competing firms name and organise the same work, recorded verbatim from their own sites. Use it to check our service names against the words buyers already read, not to copy them."
>
  {
    entries.length === 0 ? (
      <p class="mt-8 rounded-sm border border-dashed border-rule p-5 text-ink-muted">
        No market-language records yet. Add them to{' '}
        <code>src/data/market-language.yaml</code>.
      </p>
    ) : (
      <div
        class="mt-8 overflow-x-auto"
        tabindex="0"
        role="region"
        aria-label="Market language table, scrollable"
      >
        <table class="w-full min-w-[60rem]">
          <caption class="mb-2 text-left text-sm text-ink-muted">
            How competing firms name and organise the same work
          </caption>
          <thead>
            <tr>
              <th scope="col" class={th}>Firm</th>
              <th scope="col" class={th}>City</th>
              <th scope="col" class={th}>Menu headings, verbatim</th>
              <th scope="col" class={th}>Organising principle</th>
              <th scope="col" class={th}>Observed</th>
              <th scope="col" class={th}>Provenance</th>
            </tr>
          </thead>
          <tbody>
            {entries.map((entry) => (
              <tr>
                <th scope="row" class={`${td} font-semibold`}>
                  {entry.url ? (
                    <a href={entry.url} rel="nofollow noopener">
                      {entry.firm_name}
                    </a>
                  ) : (
                    entry.firm_name
                  )}
                </th>
                <td class={td}>{entry.city}</td>
                <td class={td}>
                  {entry.menu_headings.length > 0 ? (
                    <ol class="list-decimal pl-4">
                      {entry.menu_headings.map((heading) => (
                        <li>{heading}</li>
                      ))}
                    </ol>
                  ) : (
                    '—'
                  )}
                </td>
                <td class={td}>{entry.organizing_principle}</td>
                <td class={td}>{entry.observed_at ?? ''}</td>
                <td class={td}>
                  <Provenance record={entry} />
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</InternalLayout>
