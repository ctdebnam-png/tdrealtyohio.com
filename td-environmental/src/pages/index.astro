---
import BaseLayout from '../layouts/BaseLayout.astro';
import CredentialStrip from '../components/CredentialStrip.astro';
import ServiceTile from '../components/ServiceTile.astro';
import { SITE, serviceAreaSentence } from '../lib/site.js';
import { getPublicServices, SEGMENT_LABELS } from '../lib/data.js';
import { SEGMENT_COPY } from '../lib/segments.js';

const services = getPublicServices();
const tiles = services.slice(0, 6);

const highlighted = (['consulting_firm', 'lender', 'developer'] as const).map((segment) => ({
  segment,
  copy: SEGMENT_COPY[segment],
}));
---

<BaseLayout
  title="Environmental site assessment in central Ohio"
  description={SITE.tagline}
>
  <section class="border-b border-rule bg-white">
    <div class="wrap py-14">
      <h1 class="max-w-4xl text-4xl sm:text-5xl">
        Environmental site assessment and compliance support in central Ohio
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-ink-muted">
        {SITE.name} assesses property conditions for owners, lenders, developers,
        and consulting firms across the {SITE.city} and Columbus market, and
        delivers the report the transaction or the programme requires.
      </p>
      <p class="mt-6 flex flex-wrap gap-3">
        <a
          href="/request-a-proposal/"
          class="rounded-sm bg-moss-deep px-5 py-3 font-semibold text-white no-underline hover:bg-moss"
        >
          Request a proposal
        </a>
        <a
          href={SITE.phone_href}
          class="rounded-sm border border-moss-deep px-5 py-3 font-semibold text-moss-deep no-underline hover:bg-moss-tint"
        >
          Call {SITE.phone_display}
        </a>
      </p>
    </div>
  </section>

  <CredentialStrip />

  {
    /*
     * No services published means no "What we do" section. An empty heading
     * with an apology under it is worse than no heading: this page is read by
     * lenders and consulting firms, and a section that says nothing invites
     * them to conclude the firm does nothing.
     */
    tiles.length > 0 && (
      <section aria-labelledby="services-heading" class="wrap py-14">
        <h2 id="services-heading" class="text-2xl">
          What we do
        </h2>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {tiles.map((service) => (
            <ServiceTile service={service} />
          ))}
        </ul>
        {services.length > tiles.length && (
          <p class="mt-6">
            <a href="/services/">All {services.length} services with scope and deliverables</a>
          </p>
        )}
      </section>
    )
  }

  <section aria-labelledby="buyers-heading" class="border-y border-rule bg-white">
    <div class="wrap py-14">
      <h2 id="buyers-heading" class="text-2xl">Who we work for</h2>
      <ul class="mt-6 grid gap-4 md:grid-cols-3">
        {
          highlighted.map(({ segment, copy }) => (
            <li class="rounded-sm border border-rule p-5">
              <h3 class="text-lg">
                <a
                  href={`/who-we-serve/${SEGMENT_LABELS[segment].slug}/`}
                  class="no-underline hover:underline"
                >
                  {copy.title}
                </a>
              </h3>
              <p class="mt-2 text-sm text-ink-muted">{copy.summary}</p>
            </li>
          ))
        }
      </ul>
      <p class="mt-6">
        <a href="/who-we-serve/">Every buyer we work for, and what each one needs</a>
      </p>
    </div>
  </section>

  <section aria-labelledby="area-heading" class="wrap py-14">
    <h2 id="area-heading" class="text-2xl">Service area</h2>
    <p class="mt-3 max-w-2xl text-lg">{serviceAreaSentence()}</p>
    <p class="mt-3 max-w-2xl text-ink-muted">
      Work outside those counties is taken case by case. Ask, and we will tell you
      plainly whether we are the right firm for it.
    </p>
  </section>
</BaseLayout>
