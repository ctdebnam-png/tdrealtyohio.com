---
import { getPublishableCredentials } from '../lib/data.js';

/**
 * Publishes only credentials that are displayable on joining or already
 * earned. Nothing aspirational appears here: a credential in the plan but not
 * yet held is on /internal/credentials/, not on the public site.
 */
const credentials = getPublishableCredentials();
---

{
  credentials.length > 0 && (
    <section aria-labelledby="credential-strip" class="border-y border-rule bg-moss-tint">
      <div class="wrap py-6">
        <h2 id="credential-strip" class="text-sm font-semibold uppercase tracking-wide text-moss-deep">
          Credentials held
        </h2>
        <ul class="mt-3 flex flex-wrap gap-x-6 gap-y-2 text-sm">
          {credentials.map((credential) => (
            <li class="flex items-baseline gap-2">
              <span class="font-medium">{credential.name}</span>
              {credential.license_number && (
                <span class="text-ink-muted">#{credential.license_number}</span>
              )}
            </li>
          ))}
        </ul>
        <p class="mt-3 text-sm">
          <a href="/about/certifications/">Full certification list with issuing bodies</a>
        </p>
      </div>
    </section>
  )
}
