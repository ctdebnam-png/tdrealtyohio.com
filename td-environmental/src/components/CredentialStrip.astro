---
import { getPublishableCredentials } from '../lib/data.js';

/**
 * "Credentials held" must mean held. A credential flagged
 * displayable_on_join but not yet earned is a plan, and a plan advertised as a
 * holding is the one thing this repository exists to prevent — so the strip
 * shows only credentials with an earned_at date. The fuller list, which the
 * brief asks to include displayable-on-join credentials, is on
 * /about/certifications/, where each one's status is stated.
 *
 * Credentials that two people both hold appear once: the strip names what the
 * firm can field, not how many copies of it there are.
 */
const earned = getPublishableCredentials().filter((credential) => credential.earned_at !== null);

const unique = [...new Map(
  earned.map((credential) => [
    `${credential.name}|${credential.license_number ?? ''}`,
    credential,
  ]),
).values()];
---

{
  unique.length > 0 && (
    <section aria-labelledby="credential-strip" class="border-y border-rule bg-moss-tint">
      <div class="wrap py-6">
        <h2 id="credential-strip" class="text-sm font-semibold uppercase tracking-wide text-moss-deep">
          Credentials held
        </h2>
        <ul class="mt-3 flex flex-wrap gap-x-6 gap-y-2 text-sm">
          {unique.map((credential) => (
            <li class="flex items-baseline gap-2">
              <span class="font-medium">{credential.name}</span>
              {credential.license_number && (
                <span class="text-ink-muted">#{credential.license_number}</span>
              )}
            </li>
          ))}
        </ul>
        <p class="mt-3 text-sm">
          <a href="/about/certifications/">Full certification list with issuing bodies</a>
        </p>
      </div>
    </section>
  )
}
