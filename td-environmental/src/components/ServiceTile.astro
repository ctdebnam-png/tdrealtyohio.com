---
import type { Service } from '../lib/data.js';

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<li class="rounded-sm border border-rule bg-white p-5">
  <h3 class="text-lg">
    <a href={`/services/${service.slug}/`} class="no-underline hover:underline">
      {service.name}
    </a>
  </h3>
  {
    service.standard && (
      <p class="mt-1 text-sm font-medium text-clay">Runs under {service.standard}</p>
    )
  }
  <p class="mt-2 text-sm text-ink-muted">{service.description}</p>
</li>
