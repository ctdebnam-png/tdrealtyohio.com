---
import { SITE, IS_PUBLISHED } from '../lib/site.js';

const { pathname } = Astro.url;
const isCurrent = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);

const nav = [
  { href: '/services/', label: 'Services' },
  { href: '/who-we-serve/', label: 'Who we serve' },
  { href: '/projects/', label: 'Projects' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
---

<header class="border-b border-rule bg-white">
  <div class="wrap flex flex-wrap items-center justify-between gap-4 py-4">
    <a href="/" class="text-lg font-semibold tracking-tight text-moss-deep no-underline">
      {SITE.name}
      <span class="block text-xs font-normal text-ink-muted">
        {SITE.city}, {SITE.state}
      </span>
    </a>

    <nav aria-label="Main">
      <ul class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="no-underline hover:underline"
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      /*
       * Held means no intake path of any kind. A phone number is a route to a
       * real enquiry just as a form is, so it is absent — not disabled, not
       * greyed out — until the work behind it can be insured.
       */
      IS_PUBLISHED && (
        <p class="text-sm">
          <a href={SITE.phone_href} class="font-semibold no-underline hover:underline">
            Call {SITE.phone_display}
          </a>
        </p>
      )
    }
  </div>
</header>
