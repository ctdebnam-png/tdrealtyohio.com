---
import { SITE } from '../lib/site.js';

/**
 * Shown on a public page when a data-driven section has no records yet.
 *
 * This is read by clients, so it says what a visitor needs — not what a
 * developer needs. Repository paths, file names, and instructions to add
 * records belong on /internal/, never here.
 */
interface Props {
  /** A complete sentence in the firm's voice, addressed to a visitor. */
  message: string;
}

const { message } = Astro.props;
---

<p class="rounded-sm border border-rule bg-white p-5 text-ink-muted">
  {message}
  <a href={SITE.phone_href} class="whitespace-nowrap">Call {SITE.phone_display}</a>
  and we will tell you plainly what we can take on today.
</p>
