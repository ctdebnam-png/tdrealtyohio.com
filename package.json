{
  "name": "tdrealtyohio",
  "version": "1.0.0",
  "description": "TD Realty Ohio - Low Commission Real Estate Brokerage",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "npx wrangler pages dev . --port 8788",
    "test": "npx playwright test",
    "test:ui": "npx playwright test --ui",
    "test:screenshots": "npx playwright test --project=mobile-375x812 --project=desktop-1280x800 visual-regression",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "validate": "node scripts/indexing-guard.mjs",
    "check:nav": "node scripts/check-nav.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "check:templates": "node scripts/check-templates.js",
    "check:nav-and-copy": "node scripts/check-nav-and-copy.js",
    "check:all": "node scripts/indexing-guard.mjs && node scripts/check-nav.mjs && node scripts/check-copy.mjs && node scripts/check-templates.js && node scripts/check-nav-and-copy.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "cheerio": "^1.2.0",
    "glob": "^13.0.1",
    "wrangler": "^4.0.0"
  }
}
