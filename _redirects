# ========================================
# TD Realty Ohio - URL Canonicalization
# ========================================

# Canonical URL strategy:
# - Clean routes (e.g., /sellers/) are canonical
# - .html URLs redirect to clean routes (301)
# - Clean routes rewrite to serve .html files (200)
# - Directories use trailing slash (e.g., /areas/, /blog/)

# ----------------------------------------
# Redirect .html URLs to clean routes (SEO)
# ----------------------------------------
/index.html             /                       301
/sellers.html           /sellers/               301
/buyers.html            /buyers/                301
/contact.html           /contact/               301
/about.html             /about/                 301
# privacy, terms, fair-housing, agents use directory structure - redirect old .html URLs
/privacy.html           /privacy/               301
/terms.html             /terms/                 301
/fair-housing.html      /fair-housing/          301
/agents.html            /agents/                301
/referrals.html         /referrals/             301
/home-value.html        /home-value/            301
/affordability.html     /affordability/         301
/sitemap-page.html      /sitemap-page/          301
/pre-listing-inspection.html /pre-listing-inspection/ 301
/1-percent-commission.html /1-percent-commission/ 301

# ----------------------------------------
# All pages now use directory structure (index.html) - no rewrites needed
# ----------------------------------------

# ----------------------------------------
# Legacy route redirects
# ----------------------------------------
/agent-opportunities    /agents/                301
/agent-opportunities/   /agents/                301

# ----------------------------------------
# City landing pages
# ----------------------------------------
# Redirect cities without dedicated pages to main areas page
/areas/galena/          /areas/                 301
/areas/galena/*         /areas/                 301
