# ========================================
# TD Realty Ohio - URL Canonicalization
# ========================================

# Host canonicalization: www to non-www
# (Cloudflare Pages handles this at the edge)
https://www.tdrealtyohio.com/* https://tdrealtyohio.com/:splat 301

# Canonical URL strategy:
# - Clean routes with trailing slashes (e.g., /sellers/) are canonical
# - .html URLs redirect to clean routes (301)
# - Non-trailing-slash URLs redirect to trailing-slash canonical (301)
# - Directories use trailing slash (e.g., /areas/, /blog/)

# ----------------------------------------
# Redirect non-trailing-slash to trailing-slash canonical
# ----------------------------------------
/sellers                /sellers/               301
/buyers                 /buyers/                301
/contact                /contact/               301
/about                  /about/                 301
/privacy                /privacy/               301
/terms                  /terms/                 301
/fair-housing           /fair-housing/          301
/agents                 /agents/                301
/referrals              /referrals/             301
/home-value             /home-value/            301
/affordability          /affordability/         301
/sitemap-page           /sitemap-page/          301
/pre-listing-inspection /pre-listing-inspection/ 301
/1-percent-commission   /1-percent-commission/  301
/areas                  /areas/                 301
/blog                   /blog/                  301
/testimonials           /                       301
/testimonials/          /                       301
/compare                /compare/               301
/faq                    /faq/                   301
/sell-and-buy           /1-percent-commission/  301
/sell-and-buy/          /1-percent-commission/  301
/sell-only-2-percent    /sell-only-2-percent/   301

